stateDiagram-v2
    [*] --> COLD_AND_DARK

    state COLD_AND_DARK
    state DETUMBLE
    state SAFE
    state SLEWING
    state SUN_POINTING
    state DETECTION
    state RELAY
    COLD_AND_DARK --> DETUMBLE : cold_to_detumble: COLD_AND_DARK AND time_sec >= startup_cold_sec
    DETUMBLE --> SAFE : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    DETUMBLE --> SLEWING : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    DETUMBLE --> SUN_POINTING : detumble_complete: DETUMBLE AND detumble_complete == True
    SAFE --> DETECTION : recovery -> DETECTION
    SAFE --> RELAY : recovery -> RELAY
    SAFE --> SLEWING : recovery -> SLEWING
    SAFE --> SUN_POINTING : safe_critical_recovery_confirmed: current_mode == SAFE AND in_critical_recovery AND recovery conditions met (debounced)
    SLEWING --> DETECTION : slew_complete: SLEWING active AND time_sec >= slew_end_time_sec
    SLEWING --> RELAY : slew_complete: SLEWING active AND time_sec >= slew_end_time_sec
    SLEWING --> SAFE : slew_critical_battery: SLEWING active AND battery_wh < critical_power_wh (debounced)
    SLEWING --> SUN_POINTING : slew_complete: SLEWING active AND time_sec >= slew_end_time_sec
    SUN_POINTING --> DETECTION : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    SUN_POINTING --> RELAY : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    SUN_POINTING --> SAFE : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    SUN_POINTING --> SLEWING : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    DETECTION --> RELAY : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    DETECTION --> SAFE : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    DETECTION --> SLEWING : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
    DETECTION --> SUN_POINTING : saturation_hold_continue: adcs_saturation_hold_active AND wheel_saturation_fault_active (default - hold current mode during unloading) (hold)
